# App URL used for Discord OAuth redirect construction if DISCORD_REDIRECT_URI omitted
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite path (optional; defaults to ./data/buds.db)
# BUDS_DB_PATH=./data/buds.db

# Discord OAuth (preferred auth). Leave unset to use dev/mock login.
# Create an app at https://discord.com/developers/applications
# Redirect URL must match exactly, e.g. http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Optional: allowlist comma-separated emails for demo magic-link style login in production.
# When unset, /api/auth/dev accepts any email in development only.
# AUTH_DEV_ALLOWLIST=
