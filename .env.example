# App URL (OG tags + future OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ——— Supabase (optional for Phase A UI shell) ———
# Discover + /g/* run on seed JSON with these unset.
# When set, src/lib/supabase clients unlock for Auth / Postgres later.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Apply schema later: supabase/migrations/0001_init.sql

# ——— Legacy linkhub / local SQLite (optional) ———
# Still used by vanity /{handle} demo profiles until cutover.
# BUDS_DB_PATH=./data/buds.db

# Discord OAuth (preferred auth once wired). Leave unset to use dev login.
# Create an app at https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Dev email login (/api/auth/dev):
# - Local: optional. Without this, any non-demo email works for local review only.
# - Hosted (production / Vercel / Cursor): REQUIRED — endpoint returns 403 if unset.
# AUTH_DEV_ALLOWLIST=you@example.com
